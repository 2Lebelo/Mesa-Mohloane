@model Mesa_Mohloane_Frontend.Dtos.LoginRequestDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Mesa Mohloane</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <style>
        :root {
            --primary: #1473ff;
            --primary-hover: #005de0;
            --primary-dark: #071a4d;
            --primary-soft: #eaf2ff;
            --text-dark: #071a4d;
            --text-muted: #64748b;
            --border: #d9e2ef;
            --white: #ffffff;
            --danger: #991b1b;
            --danger-bg: #fef2f2;
            --danger-border: #fecaca;
            --radius-sm: 4px;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            font-family: Inter, Arial, sans-serif;
            background: var(--white);
            color: var(--text-dark);
        }

        .auth-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 48% 52%;
            background: var(--white);
        }

        .auth-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: var(--white);
            padding: 96px 72px 48px;
        }

        .auth-brand {
            position: absolute;
            top: 36px;
            left: 72px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--primary-dark);
            font-weight: 900;
            font-size: 22px;
            text-decoration: none;
        }

            .auth-brand i {
                color: var(--primary);
                font-size: 26px;
            }

        .auth-card {
            width: 100%;
            max-width: 460px;
        }

        .auth-title {
            color: var(--primary-dark);
            font-size: 42px;
            line-height: 1.1;
            font-weight: 900;
            letter-spacing: -1.5px;
            margin: 0 0 12px;
        }

        .auth-sub {
            color: var(--text-muted);
            font-size: 15px;
            margin: 0 0 32px;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            color: var(--primary-dark);
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 8px;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .form-control {
            width: 100%;
            min-height: 52px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 0 16px;
            font-size: 15px;
            outline: none;
            transition: border-color .2s ease, box-shadow .2s ease;
            background: #ffffff;
            color: var(--text-dark);
        }

            .form-control::placeholder {
                color: #94a3b8;
            }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(20, 115, 255, 0.12);
            }

        .password-toggle {
            position: absolute;
            right: .85rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 0;
        }

        .btn-primary {
            background: var(--primary);
            border: none;
            color: var(--white);
            cursor: pointer;
            transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
        }

            .btn-primary:hover {
                background: var(--primary-hover);
                transform: translateY(-1px);
                box-shadow: 0 10px 24px rgba(20, 115, 255, .22);
            }

        .btn-full {
            width: 100%;
        }

        .btn-lg {
            height: 54px;
            border-radius: var(--radius-sm);
            font-weight: 900;
            font-size: 15px;
        }

        .auth-visual {
            min-height: 100vh;
            background: linear-gradient(rgba(7, 26, 77, 0.88), rgba(7, 26, 77, 0.88)), url('/images/Hero_Image.png');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 72px;
            color: var(--white);
            text-align: center;
        }

        .auth-visual-content {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .auth-visual-icon {
            width: 86px;
            height: 86px;
            border-radius: 18px;
            background: var(--primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 26px;
            box-shadow: 0 20px 45px rgba(20, 115, 255, 0.35);
        }

            .auth-visual-icon i {
                font-size: 36px;
            }

        .auth-visual h2 {
            font-size: 42px;
            line-height: 1.18;
            font-weight: 900;
            letter-spacing: -1px;
            margin: 0 0 14px;
            color: #ffffff;
        }

        .auth-visual p {
            color: #dbeafe;
            font-size: 16px;
            line-height: 1.7;
            max-width: 420px;
            margin: 0 auto;
        }

        .auth-stats {
            display: flex;
            gap: 1rem;
            margin-top: 2.5rem;
            justify-content: center;
            align-items: center;
        }

        .auth-stat {
            text-align: center;
            min-width: 82px;
        }

        .auth-stat-value {
            font-size: 1.5rem;
            font-weight: 900;
            color: #ffffff;
        }

        .auth-stat-label {
            font-size: .75rem;
            color: #cbd5e1;
        }

        .auth-stat-divider {
            width: 1px;
            height: 42px;
            background: rgba(255,255,255,.18);
        }

        .alert-danger {
            border: 1px solid var(--danger-border);
            background: var(--danger-bg);
            color: var(--danger);
            border-radius: var(--radius-sm);
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 14px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .auth-link {
            color: var(--primary);
            font-weight: 800;
            text-decoration: none;
        }

            .auth-link:hover {
                text-decoration: underline;
            }

        .remember-row {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: 1.5rem;
        }

            .remember-row input {
                accent-color: var(--primary);
                width: 15px;
                height: 15px;
            }

            .remember-row label {
                color: var(--text-muted);
                font-size: .9rem;
                cursor: pointer;
            }

        @@media (max-width: 992px) {
            .auth-page {
                grid-template-columns: 1fr;
            }

            .auth-visual {
                display: none;
            }

            .auth-panel {
                min-height: 100vh;
                padding: 120px 28px 48px;
            }

            .auth-brand {
                left: 28px;
            }

            .auth-card {
                max-width: 520px;
            }
        }

        @@media (max-width: 576px) {
            .auth-title {
                font-size: 34px;
            }
        }
    </style>
</head>

<body>
    <div class="auth-page">
        <div class="auth-panel">
            <a href="/" class="auth-brand">
                <i class="fa-solid fa-city"></i>
                Mesa Mohloane
            </a>

            <div class="auth-card">
                <h1 class="auth-title">Sign in to your account</h1>
                <p class="auth-sub">Welcome back — access your smart city infrastructure portal.</p>

                @if (ViewData["Error"] is not null)
                {
                    <div id="error-alert" class="alert-danger">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span id="error-msg">@(ViewData["Error"] as string ?? "Invalid credentials.")</span>
                    </div>
                }

                <form method="post" asp-controller="Auth" asp-action="Login" novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string ?? "")" />

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label" style="display:flex;justify-content:space-between;align-items:center">
                            <span>Password</span>
                            <a href="/Auth/ForgotPassword" class="auth-link" style="font-size:.8rem;text-transform:none;letter-spacing:0">
                                Forgot password?
                            </a>
                        </label>

                        <div style="position:relative">
                            <input asp-for="Password"
                                   type="password"
                                   id="password"
                                   class="form-control"
                                   placeholder="••••••••"
                                   autocomplete="current-password"
                                   required
                                   style="padding-right:2.75rem" />

                            <button type="button"
                                    id="toggle-pw"
                                    class="password-toggle"
                                    aria-label="Toggle password visibility">
                                <i class="fa-solid fa-eye" id="pw-icon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="remember-row">
                        <input type="checkbox" id="remember" />
                        <label for="remember">Remember me</label>
                    </div>

                    <button type="submit" class="btn-primary btn-full btn-lg">
                        Login
                    </button>
                </form>

                <p style="text-align:center;margin-top:1.5rem;font-size:.9rem;color:#64748b">
                    Don't have an account?
                    <a href="/Auth/Register" class="auth-link">Sign up</a>
                </p>
            </div>
        </div>

        <div class="auth-visual">
            <div class="auth-visual-content">
                <div class="auth-visual-icon">
                    <i class="fa-solid fa-building-shield"></i>
                </div>

                <h2>Mesa Mohloane Smart City</h2>
                <p>
                    Manage connected infrastructure, community services, and smart city operations
                    through one secure digital platform.
                </p>

                <div class="auth-stats">
                    <div class="auth-stat">
                        <div class="auth-stat-value">Secure</div>
                        <div class="auth-stat-label">Access</div>
                    </div>

                    <div class="auth-stat-divider"></div>

                    <div class="auth-stat">
                        <div class="auth-stat-value">Smart</div>
                        <div class="auth-stat-label">Services</div>
                    </div>

                    <div class="auth-stat-divider"></div>

                    <div class="auth-stat">
                        <div class="auth-stat-value">24/7</div>
                        <div class="auth-stat-label">Portal</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById('toggle-pw')?.addEventListener('click', () => {
            const password = document.getElementById('password');
            const icon = document.getElementById('pw-icon');

            if (!password || !icon) return;

            const isText = password.type === 'text';
            password.type = isText ? 'password' : 'text';
            icon.className = isText ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
        });
    </script>
</body>
</html>
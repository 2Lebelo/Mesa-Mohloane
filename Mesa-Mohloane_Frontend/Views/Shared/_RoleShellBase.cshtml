@using Microsoft.AspNetCore.Antiforgery
@using System.Text.Json
@inject IAntiforgery Antiforgery
@inject IConfiguration Configuration

@{
    string role = ViewData["Role"] as string ?? "Citizen";
    string title = ViewData["Title"] as string ?? "Mesa Mohloane";
    string active = ViewData["ActiveNav"] as string ?? "";
    string userName = ViewData["UserName"] as string ?? role;
    string userEmail = ViewData["UserEmail"] as string ?? "";
    string userRole = ViewData["UserRole"] as string ?? role;
    string jwtToken = ViewData["JwtToken"]?.ToString() ?? "";
    string apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:5224";

    var afToken = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken ?? "";

    var nav = new Dictionary<string, (string href, string key, string icon, string text)[]>();

    if (role == "Citizen")
    {
        nav["Overview"] = new[]
        {
            ("/Citizen/Dashboard", "Dashboard", "fa-gauge-high", "Dashboard")
        };

        nav["Incidents"] = new[]
        {
            ("/Citizen/ReportIncident", "ReportIncident", "fa-plus-circle", "Report Incident"),
            ("/Citizen/MyIncidents", "MyIncidents", "fa-triangle-exclamation", "My Incidents")
        };

        nav["Work Completion"] = new[]
        {
            ("/Citizen/CompletedJobs", "CompletedJobs", "fa-circle-check", "Completed Jobs"),
            ("/Citizen/Ratings", "Ratings", "fa-star", "Ratings")
        };

        nav["Account"] = new[]
        {
            ("/Citizen/Notifications", "Notifications", "fa-bell", "Notifications"),
            ("/Citizen/Profile", "Profile", "fa-circle-user", "My Profile")
        };
    }
    else if (role == "Contractor")
    {
        nav["Overview"] = new[]
        {
            ("/Contractor/Dashboard", "Dashboard", "fa-gauge-high", "Dashboard")
        };

        nav["Tendering"] = new[]
        {
            ("/Contractor/OpenIncidents", "OpenIncidents", "fa-briefcase", "Open Incidents"),
            ("/Contractor/MyTenders", "MyTenders", "fa-file-contract", "My Tenders")
        };

        nav["Execution"] = new[]
        {
            ("/Contractor/MyAssignments", "MyAssignments", "fa-person-digging", "My Assignments"),
            ("/Contractor/MyInvoices", "Invoices", "fa-file-invoice-dollar", "Invoices")
        };

        nav["Account"] = new[]
        {
            ("/Contractor/Ratings", "Ratings", "fa-star", "Ratings"),
            ("/Contractor/Notifications", "Notifications", "fa-bell", "Notifications"),
            ("/Contractor/Profile", "Profile", "fa-circle-user", "My Profile")
        };
    }
    else
    {
        nav["Overview"] = new[]
        {
            ("/Inspector/Dashboard", "Dashboard", "fa-gauge-high", "Dashboard")
        };

        nav["Audit"] = new[]
        {
            ("/Inspector/AuditLogs", "AuditLogs", "fa-shield-halved", "Audit Logs"),
            ("/Inspector/IncidentActivity", "IncidentActivity", "fa-triangle-exclamation", "Incident Activity"),
            ("/Inspector/TenderActivity", "TenderActivity", "fa-file-contract", "Tender Activity")
        };

        nav["Finance Review"] = new[]
        {
            ("/Inspector/FlaggedInvoices", "FlaggedInvoices", "fa-flag", "Flagged Invoices"),
            ("/Inspector/InvoiceReviews", "InvoiceReviews", "fa-file-invoice-dollar", "Invoice Reviews")
        };

        nav["Account"] = new[]
        {
            ("/Inspector/Notifications", "Notifications", "fa-bell", "Notifications"),
            ("/Inspector/Profile", "Profile", "fa-circle-user", "My Profile")
        };
    }

    string profileUrl = role switch
    {
        "Citizen" => "/Citizen/Profile",
        "Contractor" => "/Contractor/Profile",
        "Inspector" => "/Inspector/Profile",
        "Auditor" => "/Inspector/Profile",
        _ => $"/{role}/Dashboard"
    };

    string notificationsUrl = role switch
    {
        "Auditor" => "/Inspector/Notifications",
        _ => $"/{role}/Notifications"
    };

    string dashboardUrl = role switch
    {
        "Auditor" => "/Inspector/Dashboard",
        _ => $"/{role}/Dashboard"
    };

    string avatarInitial = string.IsNullOrWhiteSpace(userName)
        ? role.Substring(0, 1).ToUpperInvariant()
        : userName.Trim().Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — Mesa Mohloane</title>

    <meta name="mesa-api-base-url" content="@apiBaseUrl" />
    <meta name="mesa-jwt-token" content="@jwtToken" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary: linear-gradient(90deg, #1473FF 0%, #005DE0 100%);
            --primary-solid: #1473FF;
            --primary-dark: #071A4D;
            --accent: #1B4F8A;
            --bg: #F0F4F8;
            --surface: #FFFFFF;
            --surface-2: #F5F8FA;
            --border: #D1DCE8;
            --text-primary: #0D1B2A;
            --text-secondary: #3D5166;
            --text-muted: #7A93AC;
            --danger: #DC2626;
            --success: #16A34A;
            --warning: #D97706;
            --sidebar-w: 250px;
            --radius: 6px;
            --radius-lg: 14px;
            --shadow-sm: 0 1px 4px rgba(13, 27, 42, .07);
            --shadow-lg: 0 18px 40px rgba(13, 27, 42, .14);
            --transition: .16s ease;
            --font: 'Plus Jakarta Sans', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text-primary);
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }

        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: var(--sidebar-w);
            position: fixed;
            inset: 0 auto 0 0;
            background: #071A4D;
            background-image: linear-gradient(180deg, #071A4D 0%, #0B245F 100%);
            display: flex;
            flex-direction: column;
            z-index: 50;
        }

        .sidebar-brand {
            display: flex;
            gap: .7rem;
            align-items: center;
            padding: 1.4rem 1.25rem;
            color: #FFFFFF;
            text-decoration: none;
            font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .sidebar-brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sidebar-brand span {
            display: block;
            font-size: .65rem;
            color: #8FA9C8;
            font-weight: 400;
            margin-top: .1rem;
        }

        .sidebar-nav {
            padding: 0 .7rem;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 0;
                height: 0;
            }

        .sidebar-section {
            padding: 1.15rem 1.1rem .35rem;
            color: #6B8BAD;
            font-size: .63rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .6rem .85rem;
            border-radius: 7px;
            color: #A9BED5;
            text-decoration: none;
            font-size: .845rem;
            transition: var(--transition);
        }

            .sidebar-link.active,
            .sidebar-link:hover {
                background: var(--primary);
                color: #FFFFFF;
            }

            .sidebar-link i {
                width: 17px;
                text-align: center;
            }

        .sidebar-footer {
            padding: .9rem .7rem;
            border-top: 1px solid rgba(255,255,255,.06);
        }

        .sidebar-user {
            display: flex;
            gap: .75rem;
            align-items: center;
            color: #C8D8E8;
            text-decoration: none;
            padding: .55rem .7rem;
            border-radius: 9px;
            transition: var(--transition);
        }

            .sidebar-user:hover {
                background: rgba(255,255,255,.08);
            }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-weight: 800;
            flex-shrink: 0;
        }

        .sidebar-user-name {
            font-size: .82rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .sidebar-user-role {
            display: block;
            color: #8FA9C8;
            font-size: .68rem;
            margin-top: .1rem;
        }

        .main-content {
            margin-left: var(--sidebar-w);
            width: calc(100% - var(--sidebar-w));
            min-height: 100vh;
        }

        .topbar {
            height: 64px;
            background: #FFFFFF;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 1.75rem;
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .topbar-search {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: .42rem .85rem;
            display: flex;
            align-items: center;
            gap: .55rem;
            min-width: 260px;
            color: var(--text-muted);
        }

            .topbar-search input {
                border: 0;
                background: transparent;
                outline: 0;
                width: 100%;
                color: var(--text-primary);
            }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: .55rem;
        }

        .topbar-btn {
            width: 36px;
            height: 36px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            background: #FFFFFF;
            text-decoration: none;
            cursor: pointer;
            position: relative;
            transition: var(--transition);
        }

            .topbar-btn:hover,
            .topbar-btn.active {
                border-color: var(--primary-solid);
                color: var(--primary-solid);
                background: #EFF6FF;
            }

        .notif-dot {
            position: absolute;
            top: 7px;
            right: 8px;
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: var(--danger);
            border: 1px solid #FFFFFF;
        }

        .action-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-menu {
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: var(--shadow-lg);
            min-width: 220px;
            z-index: 100;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            transition: var(--transition);
            overflow: hidden;
        }

            .dropdown-menu.show {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

        .dropdown-header {
            padding: .85rem 1rem;
            border-bottom: 1px solid var(--border);
            background: var(--surface-2);
        }

        .dropdown-user-name {
            font-size: .86rem;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.25;
        }

        .dropdown-user-meta {
            font-size: .72rem;
            color: var(--text-muted);
            margin-top: .15rem;
            word-break: break-word;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .75rem 1rem;
            font-size: .835rem;
            color: var(--text-secondary);
            cursor: pointer;
            transition: background .12s ease;
            text-decoration: none;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }

            .dropdown-item:hover {
                background: var(--surface-2);
                color: var(--text-primary);
            }

            .dropdown-item i {
                width: 16px;
                text-align: center;
            }

            .dropdown-item.danger {
                color: var(--danger);
            }

                .dropdown-item.danger:hover {
                    background: #FEF2F2;
                }

        .dropdown-divider {
            height: 1px;
            background: var(--border);
            margin: .25rem 0;
        }

        .page-content {
            padding: 1.75rem;
        }

        .page-header {
            margin-bottom: 1.75rem;
        }

        .page-title {
            font-size: 1.35rem;
            font-weight: 700;
        }

        .page-breadcrumb {
            display: flex;
            gap: .4rem;
            font-size: .78rem;
            color: var(--text-muted);
            margin-top: .2rem;
        }

        .grid {
            display: grid;
            gap: 1.2rem;
        }

        .grid-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .grid-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .grid-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .grid-2-1 {
            grid-template-columns: 2fr 1fr;
        }

        .card {
            background: #FFFFFF;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
        }

        .card-header {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid #E8EFF5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .card-title {
            font-weight: 600;
        }

        .card-subtitle,
        .text-muted {
            color: var(--text-muted);
            font-size: .78rem;
        }

        .card-body {
            padding: 1.5rem;
        }

        .stat-card {
            background: #FFFFFF;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.35rem;
            display: flex;
            gap: .9rem;
            min-width: 0;
        }

        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .blue {
            background: #E8F0FA;
            color: var(--accent);
        }

        .green {
            background: #E8F5EE;
            color: var(--success);
        }

        .amber {
            background: #FFF8E8;
            color: var(--warning);
        }

        .red {
            background: #FEF2F2;
            color: var(--danger);
        }

        .purple {
            background: #F5F3FF;
            color: #7C3AED;
        }

        .stat-value {
            font-size: 1.7rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: .775rem;
            color: var(--text-muted);
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: .855rem;
        }

            .table th {
                padding: .7rem 1rem;
                text-align: left;
                background: var(--surface-2);
                font-size: .7rem;
                text-transform: uppercase;
                color: var(--text-muted);
            }

            .table td {
                padding: .82rem 1rem;
                border-bottom: 1px solid #EEF2F7;
            }

        .table-wrap {
            overflow-x: auto;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .2rem .65rem;
            border-radius: 20px;
            font-size: .7rem;
            font-weight: 500;
        }

        .badge-dot::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: currentColor;
        }

        .badge-success {
            background: #ECFDF5;
            color: #065F46;
        }

        .badge-warning {
            background: #FFFBEB;
            color: #92400E;
        }

        .badge-danger {
            background: #FEF2F2;
            color: #991B1B;
        }

        .badge-info {
            background: #EFF6FF;
            color: #1E40AF;
        }

        .badge-primary {
            background: #E8F5EE;
            color: #134F2D;
        }

        .badge-gray {
            background: #F3F4F6;
            color: #374151;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            padding: .6rem 1.2rem;
            border-radius: var(--radius);
            text-decoration: none;
            border: 0;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--primary);
            color: #FFFFFF;
        }

        .btn-secondary {
            background: var(--surface-2);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }

        .btn-danger {
            background: var(--danger);
            color: #FFFFFF;
        }

        .btn-sm {
            padding: .38rem .82rem;
            font-size: .785rem;
        }

        .form-group {
            margin-bottom: 1.1rem;
        }

        .form-label {
            display: block;
            font-size: .78rem;
            margin-bottom: .38rem;
            color: var(--text-secondary);
        }

        .form-control-light,
        .form-select-light {
            width: 100%;
            padding: .58rem .9rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: #FFFFFF;
        }

        .empty-state {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--text-muted);
        }

        .mb-3 {
            margin-bottom: 1.5rem;
        }

        .mt-2 {
            margin-top: 1rem;
        }

        @@media (max-width: 900px) {
            .grid-4,
            .grid-3,
            .grid-2,
            .grid-2-1 {
                grid-template-columns: 1fr;
            }

            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .topbar {
                padding: 0 1rem;
            }

            .topbar-search {
                min-width: 0;
                flex: 1;
            }
        }
    </style>

    <script>
        window.__API_BASE__ = @Html.Raw(JsonSerializer.Serialize(apiBaseUrl));
        window.__JWT_TOKEN__ = @Html.Raw(JsonSerializer.Serialize(jwtToken));
        window.__ANTI_FORGERY__ = @Html.Raw(JsonSerializer.Serialize(afToken));
    </script>
</head>

<body data-authenticated="@(User?.Identity?.IsAuthenticated == true ? "true" : "false")"
      data-user-name="@userName"
      data-user-email="@userEmail"
      data-user-role="@userRole"
      data-jwt-token="@jwtToken">

    <div class="app-layout">
        <aside class="sidebar" id="sidebar">
            <a href="@dashboardUrl" class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="fa-solid fa-road"></i>
                </div>

                <div>
                    Mesa Mohloane
                    <span>Infrastructure System</span>
                </div>
            </a>

            <nav class="sidebar-nav">
                @foreach (var navSection in nav)
                {
                    <div class="sidebar-section">@navSection.Key</div>

                    @foreach (var item in navSection.Value)
                    {
                        <a href="@item.href" class="sidebar-link @(active == item.key ? "active" : "")">
                            <i class="fa-solid @item.icon"></i>
                            @item.text
                        </a>
                    }
                }
            </nav>

            <div class="sidebar-footer">
                <a href="@profileUrl" class="sidebar-user">
                    <div class="avatar" id="sidebar-avatar">@avatarInitial</div>

                    <div style="min-width:0">
                        <div class="sidebar-user-name" id="sidebar-user-name">@userName</div>
                        <small class="sidebar-user-role" id="sidebar-user-role">@role Portal</small>
                    </div>
                </a>
            </div>
        </aside>

        <div class="main-content">
            <header class="topbar">
                <div class="topbar-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" placeholder="Search..." aria-label="Search" />
                </div>

                <div class="topbar-actions">
                    <a href="@notificationsUrl" class="topbar-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-solid fa-bell"></i>
                        <span class="notif-dot" id="notif-dot" style="display:none"></span>
                        <span id="notif-count" style="position:absolute;top:-7px;right:-7px;font-size:.65rem;font-weight:800;color:#fff;background:var(--danger);border-radius:999px;min-width:16px;height:16px;display:flex;align-items:center;justify-content:center"></span>
                    </a>

                    <div class="action-dropdown" id="account-dropdown">
                        <button type="button"
                                class="topbar-btn"
                                id="account-menu-button"
                                data-dropdown-toggle="account-menu"
                                aria-expanded="false"
                                aria-controls="account-menu"
                                title="Account">
                            <i class="fa-solid fa-circle-user"></i>
                        </button>

                        <div class="dropdown-menu" id="account-menu">
                            <div class="dropdown-header">
                                <div class="dropdown-user-name">@userName</div>
                                <div class="dropdown-user-meta">
                                    @(string.IsNullOrWhiteSpace(userEmail) ? $"{role} Portal" : userEmail)
                                </div>
                            </div>

                            <a href="@profileUrl" class="dropdown-item">
                                <i class="fa-solid fa-user"></i>
                                My Profile
                            </a>

                            <a href="@notificationsUrl" class="dropdown-item">
                                <i class="fa-solid fa-bell"></i>
                                Notifications
                            </a>

                            <div class="dropdown-divider"></div>

                            <button type="button" class="dropdown-item danger" onclick="logout()">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                Sign out
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <main class="page-content">
                @if (IsSectionDefined("Content"))
                {
                    @await RenderSectionAsync("Content", required: false)
                }
                else
                {
                    @RenderBody()
                }
            </main>
        </div>
    </div>

    <div id="toast-container"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
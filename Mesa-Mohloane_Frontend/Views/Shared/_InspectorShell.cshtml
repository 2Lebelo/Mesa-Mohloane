@{
    Layout = "~/Views/Shared/_RoleShellBase.cshtml";
    ViewData["Role"] = "Inspector";
}

@section Content {
    @if (IsSectionDefined("Content"))
    {
        @await RenderSectionAsync("Content", required: false)
    }
    else
    {
        @RenderBody()
    }
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
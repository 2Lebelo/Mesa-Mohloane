                    <i class="fa-solid fa-file-contract"></i> Tender Applications
                </a>
                <a href="/Admin/Assignments" class="sidebar-link @(Active == "Assignments" ? "active" : "")">
                    <i class="fa-solid fa-person-digging"></i> Assignments
                </a>

                <div class="sidebar-section">Finance</div>
                <a href="/Admin/Invoices" class="sidebar-link @(Active == "Invoices" ? "active" : "")">

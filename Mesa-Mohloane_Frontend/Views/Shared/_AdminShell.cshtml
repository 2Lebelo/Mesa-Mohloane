                <a href="/Admin/Profile" class="sidebar-link @(Active == "Profile" ? "active" : "")">
                    <i class="fa-solid fa-circle-user"></i> My Profile
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user" onclick="logout()">
                    <div class="avatar" id="sidebar-avatar">A</div>
                    <div>
                        <div class="user-name" id="sidebar-user-name">Administrator</div>
                        <div class="user-role" id="sidebar-user-role">Administrator</div>
                    </div>
                    <i class="fa-solid fa-arrow-right-from-bracket" style="margin-left:auto;color:#3D5A78;font-size:.78rem"></i>
                </div>
            </div>
        </aside>

        <!-- Main -->
        <div class="main-content">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebar-toggle">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="topbar-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Search incidents, contractors…" id="global-search">
                    </div>
                </div>
                <div class="topbar-right">
                    <a href="/Admin/Notifications" class="topbar-btn" title="Notifications">
                        <i class="fa-solid fa-bell"></i>
                        <span class="notif-dot" id="notif-dot" style="display:none"></span>
                    </a>
                    <div class="action-dropdown">
                        <button class="topbar-btn" data-dropdown-toggle="profile-dd" title="Account">
                            <i class="fa-solid fa-circle-user"></i>
                        </button>
                        <div class="dropdown-menu" id="profile-dd">
                            <a href="/Admin/Profile" class="dropdown-item">
                                <i class="fa-solid fa-user"></i> My Profile
                            </a>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item danger" onclick="logout()">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign out
                            </button>

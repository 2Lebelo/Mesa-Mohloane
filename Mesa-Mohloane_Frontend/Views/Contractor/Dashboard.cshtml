@{
    Layout = "~/Views/Shared/_ContractorShell.cshtml";
    ViewData["Title"] = "Contractor Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
}
<div class="page-header"><h1 class="page-title">Contractor Dashboard</h1><div class="page-breadcrumb"><a href="#">Home</a><i class="fa-solid fa-chevron-right"></i><span>CRUMB</span></div></div><div class='grid grid-4 mb-3'><div class='stat-card'><div class='stat-icon blue'><i class='fa-solid fa-briefcase'></i></div><div><div class='stat-value' id='open'>—</div><div class='stat-label'>Open Incidents</div></div></div><div class='stat-card'><div class='stat-icon green'><i class='fa-solid fa-file-contract'></i></div><div><div class='stat-value' id='tenders'>—</div><div class='stat-label'>My Tenders</div></div></div><div class='stat-card'><div class='stat-icon purple'><i class='fa-solid fa-person-digging'></i></div><div><div class='stat-value' id='jobs'>—</div><div class='stat-label'>Assigned Jobs</div></div></div><div class='stat-card'><div class='stat-icon amber'><i class='fa-solid fa-file-invoice-dollar'></i></div><div><div class='stat-value' id='invoices'>—</div><div class='stat-label'>Invoices</div></div></div></div><div class='card'><div class='card-body'><a class='btn btn-primary' href='/Contractor/OpenIncidents'>Browse Open Incidents</a> <a class='btn btn-secondary' href='/Contractor/MyAssignments'>My Assignments</a></div></div>
@section Scripts {<script>document.addEventListener('DOMContentLoaded',async()=>{open.textContent=(await apiFetch('/api/incidents/open?page=1&pageSize=1')).totalCount||0;tenders.textContent=(await apiFetch('/api/tenders/my?page=1&pageSize=1')).totalCount||0;jobs.textContent=(await apiFetch('/api/assignments/my?page=1&pageSize=1')).totalCount||0;invoices.textContent=(await apiFetch('/api/invoices/my?page=1&pageSize=1')).totalCount||0})</script>}

@model Mesa_Mohloane_Frontend.Dtos.PagedResultDto<Mesa_Mohloane_Frontend.Dtos.NotificationDto>

@{
    Layout = "~/Views/Shared/_InspectorShell.cshtml";
    ViewData["Title"] = "Notifications";
    ViewData["ActiveNav"] = "Notifications";
}

@section Content {
    <div class="page-header">
        <h1 class="page-title">Notifications</h1>
        <div class="page-breadcrumb">
            <a asp-controller="Inspector" asp-action="Dashboard">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:.55rem"></i>
            <span>Notifications</span>
        </div>
    </div>

    @await Html.PartialAsync("~/Views/Shared/_NotificationsList.cshtml", Model)
}
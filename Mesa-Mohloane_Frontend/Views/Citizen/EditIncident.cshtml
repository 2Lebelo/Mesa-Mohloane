@model Mesa_Mohloane_Frontend.Dtos.IncidentDetailDto
@{
    Layout = "~/Views/Shared/_CitizenShell.cshtml";
    ViewData["Title"] = "Edit Incident";
    ViewData["ActiveNav"] = "MyIncidents";
}
@section Content {
<div class="page-header"><h1 class="page-title">Edit Incident</h1><div class="page-breadcrumb"><a href="/Citizen/MyIncidents">My Incidents</a><i class="fa-solid fa-chevron-right" style="font-size:.55rem"></i><span>@Model.IncidentNumber</span></div></div>
<form asp-action="EditIncident" asp-controller="Citizen" method="post" novalidate>@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><div class="card"><div class="card-header"><div><div class="card-title">Editable Incident Details</div><div class="card-subtitle">Only pending incidents can be changed</div></div><span class="badge badge-warning badge-dot">Pending</span></div><div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-group"><label class="form-label" for="title">Title</label><input class="form-control-light" id="title" name="title" value="@Model.Title" maxlength="120" required /></div><div class="form-group"><label class="form-label" for="description">Description</label><textarea class="form-control-light" id="description" name="description" rows="6" required>@Model.Description</textarea></div><div class="form-group"><label class="form-label" for="locationName">Location</label><input class="form-control-light" id="locationName" name="locationName" value="@Model.LocationName" required /></div><div class="grid grid-2"><div class="form-group"><label class="form-label" for="latitude">Latitude</label><input class="form-control-light" id="latitude" name="latitude" type="number" step="0.000001" min="-90" max="90" value="@Model.Latitude" required /></div><div class="form-group"><label class="form-label" for="longitude">Longitude</label><input class="form-control-light" id="longitude" name="longitude" type="number" step="0.000001" min="-180" max="180" value="@Model.Longitude" required /></div></div></div><div class="card-footer" style="display:flex;gap:.75rem;justify-content:flex-end"><a href="/Citizen/IncidentDetails?id=@Model.Id" class="btn btn-secondary">Cancel</a><button type="submit" class="btn btn-primary"><i class="fa-solid fa-save"></i> Save Changes</button></div></div></form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

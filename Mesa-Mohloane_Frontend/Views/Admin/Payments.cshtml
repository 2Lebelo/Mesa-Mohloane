@model Mesa_Mohloane_Frontend.Dtos.PaymentDto
@{
    Layout = "~/Views/Shared/_AdminShell.cshtml";
    ViewData["Title"] = "Payments";
    ViewData["ActiveNav"] = "Payments";
}
<div class="page-header">
    <h1 class="page-title">Payments</h1>
    <div class="page-breadcrumb"><a href="#">Home</a><i class="fa-solid fa-chevron-right"></i><span>Payments</span></div>
</div>
<div class="card">
    <div class="card-header">
        <div>
            <div class="card-title">Payment Details</div>
            <div class="card-subtitle">Initiate or review payment for invoice</div>
        </div>
    </div>
    <div class="card-body">
        @if (Model is null)
        {
            <div class="empty-state">Select an invoice to view payment details.</div>
        }
        else
        {
            <p><strong>Invoice:</strong> @Model.InvoiceId</p>
            <p><strong>Amount:</strong> @Model.Amount.ToString("C")</p>
            <p><strong>Status:</strong> @Model.Status</p>
        }
    </div>
</div>

@model Mesa_Mohloane_Frontend.Dtos.PagedResultDto<Mesa_Mohloane_Frontend.Dtos.AssignmentDto>

@{
    Layout = "~/Views/Shared/_AdminShell.cshtml";
    ViewData["Title"] = "Assignments";
    ViewData["ActiveNav"] = "Assignments";

    var items = Model?.Items ?? Array.Empty<Mesa_Mohloane_Frontend.Dtos.AssignmentDto>();
    var currentPage = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var totalCount = Model?.TotalCount ?? 0;
    var selectedStatus = ViewData["Status"] as int?;
}

@section Content {
    <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap">
        <div>
            <h1 class="page-title">Assignments</h1>
            <div class="page-breadcrumb">
                <a asp-controller="Admin" asp-action="Dashboard">Home</a>
                <i class="fa-solid fa-chevron-right" style="font-size:.55rem"></i>
                <span>Assignments</span>
            </div>
        </div>

        <a asp-controller="Admin" asp-action="TenderApplications" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-file-contract"></i>
            Tender Applications
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i><span>@TempData["Success"]</span></div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i><span>@TempData["Error"]</span></div>
    }

    <div class="card mb-3">
        <div class="card-header">
            <div>
                <div class="card-title">Assignment Filters</div>
                <div class="card-subtitle">Filter assignments by workflow status</div>
            </div>
        </div>

        <div class="card-body" style="display:flex;gap:.65rem;flex-wrap:wrap">
            <a asp-controller="Admin" asp-action="Assignments" class="btn btn-sm @(selectedStatus is null ? "btn-primary" : "btn-secondary")">All</a>
            <a asp-controller="Admin" asp-action="Assignments" asp-route-status="1" class="btn btn-sm @(selectedStatus == 1 ? "btn-primary" : "btn-secondary")">Assigned</a>
            <a asp-controller="Admin" asp-action="Assignments" asp-route-status="2" class="btn btn-sm @(selectedStatus == 2 ? "btn-primary" : "btn-secondary")">Started</a>
            <a asp-controller="Admin" asp-action="Assignments" asp-route-status="3" class="btn btn-sm @(selectedStatus == 3 ? "btn-primary" : "btn-secondary")">Completed</a>
            <a asp-controller="Admin" asp-action="Assignments" asp-route-status="4" class="btn btn-sm @(selectedStatus == 4 ? "btn-primary" : "btn-secondary")">Awaiting Approval</a>
            <a asp-controller="Admin" asp-action="Assignments" asp-route-status="5" class="btn btn-sm @(selectedStatus == 5 ? "btn-primary" : "btn-secondary")">Approved</a>
        </div>
    </div>

    <div class="grid grid-4 mb-3">
        <div class="stat-card"><div class="stat-icon blue"><i class="fa-solid fa-briefcase"></i></div><div><div class="stat-value">@totalCount</div><div class="stat-label">Total Visible</div></div></div>
        <div class="stat-card"><div class="stat-icon teal"><i class="fa-solid fa-person-digging"></i></div><div><div class="stat-value">@items.Count(x => x.Status == 2)</div><div class="stat-label">Started On Page</div></div></div>
        <div class="stat-card"><div class="stat-icon amber"><i class="fa-solid fa-hourglass-half"></i></div><div><div class="stat-value">@items.Count(x => x.Status == 4)</div><div class="stat-label">Awaiting Approval</div></div></div>
        <div class="stat-card"><div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div><div><div class="stat-value">@items.Count(x => x.Status == 5)</div><div class="stat-label">Approved On Page</div></div></div>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Assignment Register</div>
                <div class="card-subtitle">Monitor contractor execution and approve completed work</div>
            </div>
            <div class="text-sm text-muted">Page @currentPage of @totalPages</div>
        </div>

        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Incident</th>
                        <th>Contractor</th>
                        <th>Tender</th>
                        <th>Status</th>
                        <th>Assigned</th>
                        <th>Completed</th>
                        <th class="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        foreach (var assignment in items)
                        {
                            <tr>
                                <td style="font-family:var(--font-mono);font-size:.78rem">@assignment.IncidentId</td>
                                <td style="font-family:var(--font-mono);font-size:.78rem">@assignment.ContractorId</td>
                                <td style="font-family:var(--font-mono);font-size:.78rem">@assignment.TenderApplicationId</td>
                                <td>@AssignmentStatusBadge(assignment.Status)</td>
                                <td>@assignment.AssignedAt.ToString("dd MMM yyyy")</td>
                                <td>@(assignment.CompletedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="actions">
                                    <div style="display:flex;gap:.45rem;justify-content:flex-end;flex-wrap:wrap">
                                        <a asp-controller="Admin"
                                           asp-action="AssignmentDetails"
                                           asp-route-id="@assignment.Id"
                                           class="btn btn-secondary btn-sm">
                                            <i class="fa-solid fa-eye"></i>
                                            View
                                        </a>

                                        @if (assignment.Status == 4)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ApproveAssignment"
                                                  method="post"
                                                  onsubmit="return confirm('Approve this completed assignment?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@assignment.Id" />

                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    <i class="fa-solid fa-check"></i>
                                                    Approve
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fa-solid fa-briefcase"></i>
                                    <h4>No assignments found</h4>
                                    <p>Assignments will appear here after an administrator assigns a winning tender.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination">
                <div class="pagination-info">Page @currentPage of @totalPages — @totalCount records</div>
                <div class="pagination-nav">
                    @if (currentPage > 1)
                    {
                        <a asp-controller="Admin" asp-action="Assignments" asp-route-page="@(currentPage - 1)" asp-route-status="@selectedStatus" class="page-btn">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <button type="button" class="page-btn" disabled><i class="fa-solid fa-chevron-left"></i></button>
                    }

                    <span class="page-btn active">@currentPage</span>

                    @if (currentPage < totalPages)
                    {
                        <a asp-controller="Admin" asp-action="Assignments" asp-route-page="@(currentPage + 1)" asp-route-status="@selectedStatus" class="page-btn">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <button type="button" class="page-btn" disabled><i class="fa-solid fa-chevron-right"></i></button>
                    }
                </div>
            </div>
        }
    </div>
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent AssignmentStatusBadge(int status)
    {
        var html = status switch
        {
            1 => "<span class=\"badge badge-purple badge-dot\">Assigned</span>",
            2 => "<span class=\"badge badge-info badge-dot\">Started</span>",
            3 => "<span class=\"badge badge-success badge-dot\">Completed</span>",
            4 => "<span class=\"badge badge-warning badge-dot\">Awaiting Approval</span>",
            5 => "<span class=\"badge badge-primary badge-dot\">Approved</span>",
            6 => "<span class=\"badge badge-gray badge-dot\">Closed</span>",
            _ => $"<span class=\"badge badge-gray\">{status}</span>"
        };

        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}